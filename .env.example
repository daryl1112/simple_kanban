# Copy to .env and adjust as needed. Compose reads these automatically.

# --- Postgres ---
POSTGRES_USER=devboard
POSTGRES_PASSWORD=devboard
POSTGRES_DB=devboard

# --- Backend ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
